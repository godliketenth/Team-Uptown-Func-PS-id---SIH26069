# Postgres + PostGIS. Works as-is against `docker compose up db`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weather
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=720
# Synthetic ingestion tick (seconds)
SCHEDULER_INTERVAL_SECONDS=8
SCHEDULER_ENABLED=true
# Open-Meteo corroboration (free, no key). Set false to run fully offline.
OPEN_METEO_ENABLED=true
# Immutable raw payload mirror on local disk (the "data lake")
RAW_LAKE_DIR=./data/raw
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# S3-compatible raw lake (Phase 3.2). Leave blank to use the local filesystem.
S3_ENDPOINT_URL=
S3_BUCKET=nwap-raw
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Kafka transport (Phase 3.1). Leave blank to use the in-process queue.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=nwap.raw-events

# --- tuning knobs (rarely changed; shown so the full surface is visible) ---
NEWS_RSS_ENABLED=true
NEWS_RSS_TIMEOUT_SECONDS=12
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=8
S3_REGION=us-east-1
JWT_ALGORITHM=HS256
